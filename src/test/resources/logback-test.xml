<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Logging configuration for this module's tests only.

  No module here packages a logging configuration: a configuration inside a jar silently
  becomes the configuration of everything downstream of it. Test resources are not packaged,
  and logback prefers logback-test.xml over any logback.xml on the classpath, so this file is
  only ever seen by the tests in this module.

  Without it the tests would fall back to logback's built-in default, which is DEBUG on the
  console for every logger - including Netty's and Vert.x's.

  A node or service under test is quiet at INFO; what it rejected and why is at DEBUG. Raise a
  package here when diagnosing a failure, for example:

    <logger name="io.bosonnetwork.kademlia.rpc" level="DEBUG"/>

  Console only. A rolling file appender here would write a log into whatever directory the
  test JVM happened to start in.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{32} - %msg %ex{full}%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="OFF"/>
  <logger name="io.vertx" level="OFF"/>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
